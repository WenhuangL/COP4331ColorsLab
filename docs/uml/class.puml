@startuml class
' ==========================================================
'  COLORS Web Application - Class Diagram
'  The app is procedural (plain JS + PHP scripts), so each
'  page / script / endpoint / table is modelled as a class
'  with a stereotype. Attributes and operations are the real
'  variables, DOM ids, functions and JSON fields used in the
'  code. Table columns follow the course's COP4331 setup
'  script (Users, Colors).
' ==========================================================
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #F5F8FF
  BorderColor #3B5B92
  ArrowColor #3B5B92
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #C9A227
}
hide empty members
hide circle

title COLORS Web Application - Class Diagram

package "Client (Browser)" {

  class "index.html" as IndexPage <<page>> {
    loginName : text input
    loginPassword : password input
    {field} loginButton : button  [onclick = doLogin()]
    loginResult : span
  }

  class "color.html" as ColorPage <<page>> {
    userName : span
    {field} logoutButton : button  [onclick = doLogout()]
    searchText : text input
    {field} searchColorButton : button  [onclick = searchColor()]
    colorSearchResult : span
    colorList : p
    colorText : text input
    {field} addColorButton : button  [onclick = addColor()]
    colorAddResult : span
    {field} on DOMContentLoaded -> readCookie()
  }

  class "code.js" as CodeJS <<script>> {
    + urlBase : String = "http://COP4331-5.com/LAMPAPI" {readOnly}
    + extension : String = "php" {readOnly}
    + userId : int = 0
    + firstName : String = ""
    + lastName : String = ""
    --
    + doLogin() : void
    + saveCookie() : void
    + readCookie() : void
    + doLogout() : void
    + addColor() : void
    + searchColor() : void
  }

  class "md5.js" as MD5 <<library>> {
    + md5(string, key, raw) : String
  }

  class SessionCookie <<cookie>> {
    name = "firstName"
    value = "<first>,lastName=<last>,userId=<id>"
    expires = now + 20 minutes
  }

  note bottom of SessionCookie
    One cookie, not three: saveCookie() packs all
    three values into the cookie named "firstName".
    readCookie() splits the value on "," and
    doLogout() expires "firstName" (1970 date).
  end note
}

package "Server: PHP API  (api/ deployed to /LAMPAPI)" {

  class "Login.php" as LoginPHP <<endpoint>> {
    .. request JSON ..
    login : String
    password : String
    .. response JSON ..
    id : int
    firstName : String
    lastName : String
    error : String
    -- functions --
    getRequestInfo() : array
    sendResultInfoAsJson(obj : String) : void
    returnWithError(err : String) : void
    returnWithInfo(firstName, lastName, id) : void
  }

  class "SearchColors.php" as SearchPHP <<endpoint>> {
    .. request JSON ..
    search : String
    userId : int
    .. response JSON (match) ..
    results : String[]
    error : String = ""
    .. response JSON (no match) ..
    id : int = 0
    firstName : String = ""
    lastName : String = ""
    error : String = "No Records Found"
    -- functions --
    getRequestInfo() : array
    sendResultInfoAsJson(obj : String) : void
    returnWithError(err : String) : void
    returnWithInfo(searchResults : String) : void
  }

  class "AddColor.php" as AddPHP <<endpoint>> {
    .. request JSON ..
    color : String
    userId : int
    .. response JSON ..
    error : String
    -- functions --
    getRequestInfo() : array
    sendResultInfoAsJson(obj : String) : void
    returnWithError(err : String) : void
  }

  class mysqli <<PHP built-in>> {
    + connect_error : String
    --
    + prepare(query : String) : mysqli_stmt
    + close() : bool
  }
}

package "Database: MySQL  COP4331" {
  class Users <<table>> {
    ID : INT {PK, auto-increment}
    {field} FirstName : VARCHAR(50)
    {field} LastName : VARCHAR(50)
    {field} Login : VARCHAR(50)
    {field} Password : VARCHAR(50)
  }
  class Colors <<table>> {
    ID : INT {PK, auto-increment}
    {field} Name : VARCHAR(50)
    UserID : INT {refers to Users.ID}
  }

  note bottom of Colors
    No FOREIGN KEY constraint is declared;
    the PHP queries match on UserID.
    MySQL column names are case-insensitive,
    so the PHP's firstName / lastName and
    UserId refer to these columns.
  end note
}

' ---------- client-side relationships ----------
IndexPage ..> CodeJS : <<loads>>
IndexPage ..> MD5 : <<loads>>\n(md5() call in doLogin()\nis commented out)
ColorPage ..> CodeJS : <<loads>>
CodeJS ..> SessionCookie : writes / reads / expires
CodeJS ..> ColorPage : redirects to\n(after login)
CodeJS ..> IndexPage : redirects to\n(logout / no cookie)

' ---------- client -> server (HTTP POST, JSON body) ----------
CodeJS ..> LoginPHP : POST\ndoLogin()
CodeJS ..> SearchPHP : POST\nsearchColor()
CodeJS ..> AddPHP : POST\naddColor()

' ---------- server -> database ----------
LoginPHP ..> mysqli : <<create>>
SearchPHP ..> mysqli : <<create>>
AddPHP ..> mysqli : <<create>>

LoginPHP ..> Users : SELECT ID,\nfirstName, lastName\nWHERE Login=?\nAND Password=?
SearchPHP ..> Colors : SELECT Name\nWHERE Name LIKE ?\nAND UserID=?
AddPHP ..> Colors : INSERT\n(UserID, Name)

Users "1" -right- "0..*" Colors : owns >
mysqli -[hidden]-> Users

@enduml
